# Copy to .env.local (never committed) and fill in from Supabase:
# Project Settings → API. The publishable key is meant to be in the app;
# the database rules decide what each login can see.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
